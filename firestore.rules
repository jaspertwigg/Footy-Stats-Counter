rules_version = '2';

// The app's only Firestore access goes through the Cloud Function (using the
// Admin SDK, which bypasses these rules). No client ever talks to Firestore
// directly, so deny all direct reads/writes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
