    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.1",
    "multer": "^2.0.0",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2"
  }
}
