{
  "name": "functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
